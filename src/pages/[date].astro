---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ShareActions from '../components/ShareActions.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { editions, sitePath, type Issue } from '../lib/issues';
import { renderTopics, renderArticleGrid, renderRichText, renderBreadcrumbs } from '../lib/base-surfaces';
import { renderMarkdownWithHeadings } from '../lib/markdown';
import { editionTopics } from '../lib/edition-topics';
import SourceEnhancement from '../components/SourceEnhancement.astro';

export function getStaticPaths() {
  return editions.map((issue) => ({
    params: { date: issue.date },
    props: { issue },
  }));
}

interface Props {
  issue: Issue;
}

const { issue } = Astro.props;
const breadcrumbs = renderBreadcrumbs(sitePath(), issue.date);
const canonical = new URL(sitePath(`${issue.date}/`), Astro.site).href;
const content = renderMarkdownWithHeadings(issue.markdown, { date: issue.date, url: canonical });
const grid = renderArticleGrid(content.html, content.headings);
const topics = renderTopics(editionTopics(issue.markdown).map(topic=>topic.label));
const titleSurface = renderRichText('h1', issue.title.replace(/&/g,'&amp;').replace(/</g,'&lt;'));
const currentIndex = editions.findIndex(edition=>edition.date===issue.date);
const older = editions[currentIndex+1];
const newer = editions[currentIndex-1];
---

<BaseLayout
  title={`${issue.title} | Market Daily`}
  description={issue.summary}
  canonical={canonical}
  type="article"
  image={`og/${issue.date}.png`}
>
  <main id="main-content" tabindex="-1">
    <SiteHeader />
    <div class="back-link">
      <style is:inline set:html={breadcrumbs.css} />
      <Fragment set:html={breadcrumbs.html} />
    </div>
    <article>
      <div class="issue-meta">
        <span>Market Daily</span>
        <time datetime={issue.date}>{issue.date}</time>
      </div>
      <div class="issue-title"><style is:inline set:html={titleSurface.css}/><Fragment set:html={titleSurface.html}/></div>
      <p class="lede">{issue.summary}</p>
      <p class="coverage">{issue.coverage}</p>
      <div class="article-topics"><style is:inline set:html={topics.css}/><Fragment set:html={topics.html}/></div>
      <ShareActions title={`${issue.title} | Market Daily`} url={canonical} />
      <div class="article-grid"><style is:inline set:html={grid.css}/><Fragment set:html={grid.html}/></div>
      <nav class="edition-navigation" aria-label="前後の観測日誌">
        {older && <a href={sitePath(`${older.date}/`)}><span>← 前の観測 / {older.date}</span><strong>{older.title}</strong></a>}
        {newer && <a href={sitePath(`${newer.date}/`)}><span>次の観測 / {newer.date} →</span><strong>{newer.title}</strong></a>}
      </nav>
      <SourceEnhancement/>
      <script>
        import { enhanceTopicAI } from '../lib/topic-ai';
        enhanceTopicAI();
      </script>
    </article>
    <SiteFooter />
  </main>
</BaseLayout>
