---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ShareActions from '../components/ShareActions.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { editions, sitePath, type Issue } from '../lib/issues';
import { renderMarkdown } from '../lib/markdown';

export function getStaticPaths() {
  return editions.map((issue) => ({
    params: { date: issue.date },
    props: { issue },
  }));
}

interface Props {
  issue: Issue;
}

const { issue } = Astro.props;
const content = renderMarkdown(issue.markdown);
const canonical = new URL(sitePath(`${issue.date}/`), Astro.site).href;
const displayDate = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  weekday: 'short',
}).format(new Date(`${issue.date}T00:00:00+09:00`));
---

<BaseLayout
  title={`${issue.title} | Market Daily`}
  description={issue.summary}
  canonical={canonical}
  type="article"
  image={`og/${issue.date}.png`}
>
  <div class="reading-progress" aria-hidden="true"><span></span></div>
  <main>
    <SiteHeader />
    <div class="back-link">
      <a href={sitePath()}>← 記事一覧へ</a>
    </div>
    <article>
      <header class="issue-header">
        <div class="issue-meta">
          <span>Daily briefing</span>
          <time datetime={issue.date}>{displayDate}</time>
        </div>
        <h1 class="issue-title">{issue.title}</h1>
        <p class="lede">{issue.summary}</p>
        <div class="issue-utility">
          <p class="coverage">{issue.coverage}</p>
          <ShareActions title={`${issue.title} | Market Daily`} url={canonical} />
        </div>
      </header>
      <div class="article-rule"><span>Market Daily</span><i></i><b>{issue.date}</b></div>
      <div class="prose" set:html={content} />
    </article>
    <SiteFooter />
  </main>
</BaseLayout>

<script>
  const progress = document.querySelector<HTMLElement>('.reading-progress span');
  const updateProgress = () => {
    if (!progress) return;
    const scrollable = document.documentElement.scrollHeight - window.innerHeight;
    const ratio = scrollable > 0 ? Math.min(window.scrollY / scrollable, 1) : 0;
    progress.style.transform = `scaleX(${ratio})`;
  };

  updateProgress();
  addEventListener('scroll', updateProgress, { passive: true });
  addEventListener('resize', updateProgress);
</script>
