---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { editions, sitePath } from '../lib/issues';

const [latest, ...pastIssues] = editions;
const formatDate = (date: string) =>
  new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' }).format(
    new Date(`${date}T00:00:00+09:00`),
  );
---

<BaseLayout>
  <main>
    <SiteHeader />
    <section class="archive" aria-labelledby="archive-title">
      <header class="archive-heading">
        <span class="edition">Independent market intelligence / Tokyo</span>
        <h1 id="archive-title">ノイズを削り、<br /><em>次の一手</em>を読む。</h1>
        <div class="archive-intro">
          <p class="archive-description">Xで選んだ発信者の投稿から、投資アイデアと確認条件を毎朝整理します。</p>
          <p class="issue-count"><b>{editions.length}</b> issues published</p>
        </div>
      </header>
      {
        editions.length === 0 ? (
          <div class="empty">
            <h2>次の相場を考える、毎日の一枚。</h2>
            <p>初回の記事を準備しています。</p>
          </div>
        ) : (
          <div class="issue-list">
            {latest && (
              <a class="issue-card issue-card-featured" href={sitePath(`${latest.date}/`)}>
                <div class="issue-card-meta">
                  <span>Latest issue</span>
                  <time datetime={latest.date}>{formatDate(latest.date)}</time>
                </div>
                <div class="featured-number" aria-hidden="true">{latest.date.slice(-2)}</div>
                <div class="featured-copy">
                  <h2>{latest.title}</h2>
                  <p>{latest.summary}</p>
                  <span class="read-more">最新号を読む <i>↗</i></span>
                </div>
              </a>
            )}
            {pastIssues.length > 0 && <h2 class="archive-label">Previous issues</h2>}
            <div class="issue-grid">
              {pastIssues.map((issue) => (
                <a class="issue-card" href={sitePath(`${issue.date}/`)}>
                  <div class="issue-card-meta">
                    <time datetime={issue.date}>{formatDate(issue.date)}</time>
                    <span>{issue.posts.toLocaleString('ja-JP')} posts</span>
                  </div>
                  <h2>{issue.title}</h2>
                  <p>{issue.summary}</p>
                  <span class="read-more">読む <i>→</i></span>
                </a>
              ))}
            </div>
          </div>
        )
      }
    </section>
    <SiteFooter />
  </main>
</BaseLayout>
