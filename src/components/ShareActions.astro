---
import BaseShareActions from './BaseShareActions';
interface Props { title: string; url: string; }
const { title, url } = Astro.props;
const xUrl = `https://twitter.com/intent/tweet?${new URLSearchParams({ text: title, url })}`;
---
<div class="share-actions" aria-label="記事を共有">
  <BaseShareActions title={title} url={url} client:only="react">
    <div slot="fallback" class="share-controls">
      <a class="share-button share-x" href={xUrl} target="_blank" rel="noopener noreferrer">𝕏 Xでシェア</a>
      <a class="share-button" href={url}>記事の固定リンク</a>
    </div>
  </BaseShareActions>
</div>
